{
    "info": {
        "_postman_id": "opsflow-api-collection",
        "name": "OpsFlow API",
        "description": "API collection for the OpsFlow operations management system.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "variable": [
        {
            "key": "baseUrl",
            "value": "http://localhost:5000/api"
        },
        {
            "key": "customerId",
            "value": "1"
        },
        {
            "key": "productId",
            "value": "1"
        },
        {
            "key": "challanId",
            "value": "1"
        }
    ],
    "item": [
        {
            "name": "Authentication",
            "item": [
                {
                    "name": "Login",
                    "request": {
                        "method": "POST",
                        "header": {
                            "Content-Type": "application/json"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@example.com\",\n    \"password\": \"your-password\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/auth/login",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        }
                    }
                },
                {
                    "name": "Current User",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/auth/me",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "me"
                            ]
                        }
                    }
                },
                {
                    "name": "Logout",
                    "request": {
                        "method": "POST",
                        "url": {
                            "raw": "{{baseUrl}}/auth/logout",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "auth",
                                "logout"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "Customers",
            "item": [
                {
                    "name": "Get Customers",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/customers?page=1&limit=10",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "10"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Search Customers",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/customers?search=customer",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers"
                            ],
                            "query": [
                                {
                                    "key": "search",
                                    "value": "customer"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Filter Customers By Status",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/customers?status=ACTIVE",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers"
                            ],
                            "query": [
                                {
                                    "key": "status",
                                    "value": "ACTIVE"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get Customer By ID",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/customers/{{customerId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers",
                                "{{customerId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Create Customer",
                    "request": {
                        "method": "POST",
                        "header": {
                            "Content-Type": "application/json"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Test Customer\",\n    \"mobile\": \"9876543210\",\n    \"email\": \"customer@example.com\",\n    \"businessName\": \"Test Business\",\n    \"gstNumber\": \"GST123456\",\n    \"customerType\": \"RETAIL\",\n    \"address\": \"Ahmedabad, Gujarat\",\n    \"status\": \"LEAD\",\n    \"notes\": \"Test customer\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/customers",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers"
                            ]
                        }
                    }
                },
                {
                    "name": "Update Customer",
                    "request": {
                        "method": "PATCH",
                        "header": {
                            "Content-Type": "application/json"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Updated Customer\",\n    \"status\": \"ACTIVE\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/customers/{{customerId}}",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers",
                                "{{customerId}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Add Customer Follow-Up",
                    "request": {
                        "method": "POST",
                        "header": {
                            "Content-Type": "application/json"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"note\": \"Follow up regarding quotation\",\n    \"followUpDate\": \"2026-08-20T10:00:00.000Z\"\n}"
                        },
                        "url": {
                            "raw": "{{baseUrl}}/customers/{{customerId}}/follow-ups",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers",
                                "{{customerId}}",
                                "follow-ups"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Customer Follow-Ups",
                    "request": {
                        "method": "GET",
                        "url": {
                            "raw": "{{baseUrl}}/customers/{{customerId}}/follow-ups",
                            "host": [
                                "{{baseUrl}}"
                            ],
                            "path": [
                                "customers",
                                "{{customerId}}",
                                "follow-ups"
                            ]
                        }
                    }
                }
            ]
        },
